# Copy this file to .env and fill in real values for local development.
# The app also works with NO .env file at all - it falls back to SQLite
# and a development-only SECRET_KEY, which is fine for running locally.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Leave unset locally to use SQLite. On Render, this is set automatically
# when you attach a PostgreSQL database.
# DATABASE_URL=postgres://user:password@host:5432/dbname
